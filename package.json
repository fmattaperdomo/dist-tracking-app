{
  "name": "tracking-app",
  "version": "1.0.0",
  "description": "Tracking API for shipping app",
  "main": "app.js",
  "scripts": {
    "start": "node ./app.js",
    "start:prod": "pm2 delete all && pm2 start ./app.js --name=app",
    "dev": "nodemon ./app.js",
    "test": "cross-env NODE_ENV=test jest --silent --runInBand --no-color 2>test-output.log",
    "test:watch": "cross-env NODE_ENV=test jest --coverage --watch --silent --runInBand"
  },
  "keywords": [
    "tracking",
    "shipping",
    "api",
    "clean",
    "solid"
  ],
  "author": "Francisco Matta Perdomo",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.4",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.6.1",
    "nodemon": "^3.1.10",
    "rimraf": "^5.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "env-var": "^7.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  },
  "engines": {
    "node": "18.x"
  }
}
